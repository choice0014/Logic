{
  "name": "logic",
  "version": "1.0.0",
  "private": true,
  "description": "간단한 논리 회로 시뮬레이터",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "cli": "node logic-cli.cjs",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis zip",
    "dist:mac": "electron-builder --mac dmg zip"
  },
  "build": {
    "appId": "com.logic.desktop",
    "productName": "logic",
    "directories": { "output": "dist" },
    "files": ["index.html", "styles.css", "main.cjs", "logic-cli.cjs", "src/**/*", "package.json"],
    "linux": { "target": ["AppImage", "deb"], "category": "Education" },
    "win": { "target": ["nsis", "zip"] },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.education" }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
